# Optional: set this after connecting a custom domain.
# Vercel's production URL is used automatically when this is unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional override for the default Deskling feedback form.
# This is a public form identifier, not an API key or an email address.
# NEXT_PUBLIC_FORMSPREE_FORM_ID=YOUR_FORM_ID

# Optional override for Deskling's public Google Analytics measurement ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Never put passwords, private API keys, or other secrets in NEXT_PUBLIC_ variables.
